# Environment configuration for the automation platform.
# Copy to .env and fill in real values. Never commit .env.
#
# APP_ENV: dev | test | uat | prod
APP_ENV=dev
APP_LOG_LEVEL=INFO

# Test-management platform database (SQLAlchemy async URL).
# Default matches docker/docker-compose.yml MySQL service.
APP_DATABASE_URL=mysql+aiomysql://tester:testerpw@127.0.0.1:3306/automation
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=automation
MYSQL_USER=tester
MYSQL_PASSWORD=testerpw

# jmseu (German JMS) test environment credentials.
# Supply via .env or shell environment; never commit real values (rule 10).
JMSEU_TEST_USERNAME=
JMSEU_TEST_PASSWORD=
