# CI base image: Python 3.12 + uv + JRE + allure CLI.
# Pre-bakes everything the pipeline needs so CI jobs start fast (no runtime
# allure/uv install). Use it via CI_IMAGE in .gitlab-ci.yml or as the Jenkins
# docker agent image.
#
# Build:
#   docker build -f docker/Dockerfile.ci -t automation-platform:ci .
#   docker push <registry>/automation-platform:ci
#
# Then in .gitlab-ci.yml:   variables: { CI_IMAGE: "<registry>/automation-platform:ci" }
#      in Jenkinsfile:      CI_IMAGE='<registry>/automation-platform:ci'

# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy

# uv (copied from the official image, no install needed).
COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /bin/uv

# JRE + allure CLI for HTML report generation.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

ARG ALLURE_VERSION=2.30.0
RUN curl -fsSL "https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz" \
        -o /tmp/allure.tgz \
    && tar -xzf /tmp/allure.tgz -C /opt \
    && ln -sf "/opt/allure-${ALLURE_VERSION}/bin/allure" /usr/local/bin/allure \
    && rm /tmp/allure.tgz \
    && allure --version

WORKDIR /app
# The repo is checked out into /app by CI; this image only provides the toolchain.
CMD ["sh"]