# 前端构建与部署 (多阶段)
# Stage 1: node 构建 dist/
# Stage 2: nginx 托管静态文件 + 反代后端

# ---------- Stage 1: 构建 ----------
FROM node:20-alpine AS builder

WORKDIR /build

# 先复制 package*.json 利用层缓存
COPY frontend/package.json frontend/package-lock.json* ./
# 不用 npm ci: Windows 生成的 lockfile 在 Linux 容器里 bin shim 会有 node.exe 问题
RUN npm config set registry https://registry.npmmirror.com && \
    npm install --no-audit --no-fund --no-bin-links

# 复制源码并构建 (直接调 vite.js 入口, 跳过 .bin shim 的 node.exe bug)
COPY frontend/ ./
RUN node node_modules/vite/bin/vite.js build


# ---------- Stage 2: nginx 托管 ----------
FROM nginx:alpine

# 复制 nginx 配置 (反代 /api 和 /ws 到 backend:8900)
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# 复制构建产物
COPY --from=builder /build/dist /usr/share/nginx/html

# 容器内 80 端口对外
EXPOSE 80

# nginx 前台运行
CMD ["nginx", "-g", "daemon off;"]
